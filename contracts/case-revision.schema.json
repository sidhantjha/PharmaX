        "previous_analysis_id": {
          "title": "Previous Analysis Id",
          "type": "string"
        },
        "previous_first_unmet": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous First Unmet"
        },
        "previous_mitigated_unmet": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Mitigated Unmet"
        },
        "previous_unmet_vials": {
          "title": "Previous Unmet Vials",
          "type": "integer"
        },
        "revised_analysis_id": {
          "title": "Revised Analysis Id",
          "type": "string"
        },
        "revised_first_unmet": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
