      "type": "array"
    },
    "parent_id": {
      "title": "Parent Id",
      "type": "string"
    },
    "parent_snapshot_sha256": {
      "title": "Parent Snapshot Sha256",
      "type": "string"
    },
    "previous_option_recheck": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptionRecheck"
        },
        {
          "type": "null"
        }
      ]
