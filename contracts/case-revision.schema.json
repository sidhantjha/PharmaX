    "previous_scenario_version": {
      "title": "Previous Scenario Version",
      "type": "string"
    },
    "prior_constraint_memory_refs": {
      "items": {
        "type": "string"
      },
      "title": "Prior Constraint Memory Refs",
      "type": "array"
    },
    "resolution_id": {
      "title": "Resolution Id",
      "type": "string"
    },
    "revised_recommendation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revised Recommendation Id"
    },
    "revised_scenario_version": {
      "title": "Revised Scenario Version",
      "type": "string"
    }
  },
  "required": [
    "parent_id",
    "parent_snapshot_sha256",
    "resolution_id",
    "previous_scenario_version",
    "revised_scenario_version",
    "forecast_changed",
    "disposition",
    "previous_recommendation_id",
    "revised_recommendation_id",
    "previous_option_recheck",
    "forecast_deltas",
    "prior_constraint_memory_refs",
    "decision_summary"
  ],
  "title": "CaseRevision",
  "type": "object"
}
