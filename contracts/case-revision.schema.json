          "title": "Revised First Unmet"
        },
        "revised_mitigated_unmet": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revised Mitigated Unmet"
        },
        "revised_unmet_vials": {
          "title": "Revised Unmet Vials",
          "type": "integer"
        },
        "unmet_delta": {
          "title": "Unmet Delta",
          "type": "integer"
        }
      },
      "required": [
        "hospital_id",
        "previous_analysis_id",
        "revised_analysis_id",
        "previous_unmet_vials",
        "revised_unmet_vials",
        "unmet_delta",
        "previous_first_unmet",
        "revised_first_unmet",
        "previous_mitigated_unmet",
        "revised_mitigated_unmet"
      ],
      "title": "ForecastDelta",
      "type": "object"
    },
    "OptionRecheck": {
      "additionalProperties": false,
      "properties": {
        "analysis_ids": {
          "items": {
            "type": "string"
          },
          "title": "Analysis Ids",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "evaluation_id": {
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "original_unmet": {
          "title": "Original Unmet",
          "type": "integer"
        },
        "rejection_codes": {
          "items": {
            "type": "string"
          },
          "title": "Rejection Codes",
          "type": "array"
        },
        "remaining_unmet": {
          "title": "Remaining Unmet",
          "type": "integer"
        }
      },
      "required": [
        "evaluation_id",
        "candidate_id",
        "feasible",
        "original_unmet",
        "remaining_unmet",
        "rejection_codes",
        "evidence_ids",
        "analysis_ids"
      ],
      "title": "OptionRecheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "const": "conditional-reprojection-with-new-simulated-knowledge",
