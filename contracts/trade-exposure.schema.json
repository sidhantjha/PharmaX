{
  "$defs": {
    "CountryExposure": {
      "additionalProperties": false,
      "properties": {
        "country_code": {
          "title": "Country Code",
          "type": "integer"
        },
        "country_iso": {
          "title": "Country Iso",
          "type": "string"
        },
        "country_rating": {
          "$ref": "#/$defs/RiskRating"
        },
        "documented_country_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Documented Country Event Ids",
          "type": "array"
        },
        "historical_change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Change Pct"
        },
        "historical_change_reason": {
          "title": "Historical Change Reason",
          "type": "string"
        },
        "import_value_usd": {
          "title": "Import Value Usd",
          "type": "number"
        },
        "national_import_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "National Import Share"
        },
        "observed_sample_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sample Share"
        }
      },
      "required": [
        "country_iso",
        "country_code",
        "import_value_usd",
        "observed_sample_share",
        "national_import_share",
        "historical_change_pct",
        "historical_change_reason",
        "documented_country_event_ids",
        "country_rating"
      ],
      "title": "CountryExposure",
      "type": "object"
    },
    "RiskRating": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "country",
            "shipment",
            "supplier",
            "hospital"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "Low",
                "Moderate",
                "High",
                "Critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "measurements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Measurements",
          "type": "object"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "level",
        "rule_id",
        "explanation",
        "measurements",
        "evidence_ids",
        "limitations"
      ],
      "title": "RiskRating",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "TradeFlow": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "commodity_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commodity Description"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "flow": {
          "enum": [
            "M",
            "X",
            "RM",
            "RX"
          ],
          "title": "Flow",
          "type": "string"
        },
        "hs_code": {
          "pattern": "^\\d{2,6}$",
          "title": "Hs Code",
          "type": "string"
        },
        "is_aggregate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Aggregate"
        },
        "is_reported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Reported"
        },
        "partner_code": {
          "minimum": 0,
          "title": "Partner Code",
          "type": "integer"
        },
        "partner_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partner Iso"
        },
        "partner_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partner Name"
        },
        "period": {
          "pattern": "^\\d{4}(\\d{2})?$",
          "title": "Period",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "quantity_estimated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Estimated"
        },
        "quantity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Unit"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "reporter_code": {
          "minimum": 0,
          "title": "Reporter Code",
          "type": "integer"
        },
        "reporter_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reporter Iso"
        },
        "reporter_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reporter Name"
        },
        "value_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Usd"
        }
      },
      "required": [
        "record_id",
        "hs_code",
        "classification",
        "period",
        "reporter_code",
        "partner_code",
        "flow",
        "evidence"
      ],
      "title": "TradeFlow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "const": "pharmax-risk-v1",
      "default": "pharmax-risk-v1",
      "title": "Algorithm Version",
      "type": "string"
    },
    "analysis_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Analysis Id",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "classification": {
      "title": "Classification",
      "type": "string"
    },
    "complete_partner_coverage": {
      "title": "Complete Partner Coverage",
      "type": "boolean"
    },
    "context_as_of": {
      "format": "date",
      "title": "Context As Of",
      "type": "string"
    },
    "countries": {
      "items": {
        "$ref": "#/$defs/CountryExposure"
      },
      "title": "Countries",
      "type": "array"
    },
    "dataset_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "forecast_input": {
      "const": false,
      "default": false,
      "title": "Forecast Input",
      "type": "boolean"
    },
    "hs_code": {
      "title": "Hs Code",
      "type": "string"
    },
    "input_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Evidence Ids",
      "type": "array"
    },
    "input_flows": {
      "items": {
        "$ref": "#/$defs/TradeFlow"
      },
      "title": "Input Flows",
      "type": "array"
    },
    "kind": {
      "const": "derived",
      "default": "derived",
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "national_hhi": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "National Hhi"
    },
    "observed_import_value_usd": {
      "title": "Observed Import Value Usd",
      "type": "number"
    },
    "period": {
      "title": "Period",
      "type": "string"
    },
    "previous_inputs": {
      "items": {
        "$ref": "#/$defs/TradeFlow"
      },
      "title": "Previous Inputs",
      "type": "array"
    },
    "reporter_code": {
      "title": "Reporter Code",
      "type": "integer"
    },
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "value_coverage_fraction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value Coverage Fraction"
    },
    "world_import_value_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "World Import Value Usd"
    },
    "world_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/TradeFlow"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "analysis_id",
    "dataset_version",
    "input_evidence_ids",
    "assumptions",
    "limitations",
    "context_as_of",
    "reporter_code",
    "period",
    "hs_code",
    "classification",
    "input_flows",
    "world_input",
    "previous_inputs",
    "observed_import_value_usd",
    "world_import_value_usd",
    "value_coverage_fraction",
    "complete_partner_coverage",
    "national_hhi",
    "countries"
  ],
  "title": "TradeExposure",
  "type": "object"
}
