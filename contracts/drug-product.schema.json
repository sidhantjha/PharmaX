{
  "$defs": {
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "container_ml": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Ml"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "package_ndc": {
      "anyOf": [
        {
          "pattern": "^\\d{4,5}-\\d{3,4}-\\d{1,2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Ndc"
    },
    "presentation": {
      "title": "Presentation",
      "type": "string"
    },
    "product_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Product Id",
      "type": "string"
    },
    "protect_from_light": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protect From Light"
    },
    "quantity_unit": {
      "const": "vial",
      "default": "vial",
      "title": "Quantity Unit",
      "type": "string"
    },
    "storage_max_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storage Max C"
    },
    "storage_min_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storage Min C"
    },
    "strength_mg_per_ml": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strength Mg Per Ml"
    },
    "total_mg": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Mg"
    }
  },
  "required": [
    "product_id",
    "name",
    "presentation",
    "evidence"
  ],
  "title": "DrugProduct",
  "type": "object"
}
