{
  "$defs": {
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability_proof": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "extraction_status": {
      "enum": [
        "pending",
        "validated",
        "quarantined"
      ],
      "title": "Extraction Status",
      "type": "string"
    },
    "extractor_version": {
      "minLength": 1,
      "title": "Extractor Version",
      "type": "string"
    },
    "issue_date": {
      "format": "date",
      "title": "Issue Date",
      "type": "string"
    },
    "publisher": {
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "6a.1",
      "default": "6a.1",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Reference"
    }
  },
  "required": [
    "revision_id",
    "publisher",
    "document_id",
    "issue_date",
    "evidence",
    "extraction_status",
    "extractor_version"
  ],
  "title": "SourceRevision",
  "type": "object"
}
