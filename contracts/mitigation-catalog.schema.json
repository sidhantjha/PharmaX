{
  "$defs": {
    "MitigationCandidate": {
      "additionalProperties": false,
      "properties": {
        "arrival_on": {
          "format": "date",
          "title": "Arrival On",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "dispatch_on": {
          "format": "date",
          "title": "Dispatch On",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "hospital_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Hospital Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "transfer",
            "supplier_delivery",
            "reschedule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "kind_label": {
          "const": "simulated",
          "default": "simulated",
          "title": "Kind Label",
          "type": "string"
        },
        "presentation": {
          "title": "Presentation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Quantity",
          "type": "integer"
        },
        "route_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Route Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "source_id",
        "route_id",
        "hospital_id",
        "product_id",
        "presentation",
        "quantity",
        "dispatch_on",
        "arrival_on",
        "evidence_ids"
      ],
      "title": "MitigationCandidate",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "SupplierStock": {
      "additionalProperties": false,
      "properties": {
        "available_on": {
          "format": "date",
          "title": "Available On",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "expiry_date": {
          "format": "date",
          "title": "Expiry Date",
          "type": "string"
        },
        "on_hand": {
          "minimum": 0,
          "title": "On Hand",
          "type": "integer"
        },
        "presentation": {
          "title": "Presentation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "released",
            "quarantined"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "reserved": {
          "minimum": 0,
          "title": "Reserved",
          "type": "integer"
        },
        "stock_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stock Id",
          "type": "string"
        },
        "supplier_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Supplier Id",
          "type": "string"
        }
      },
      "required": [
        "stock_id",
        "supplier_id",
        "product_id",
        "presentation",
        "on_hand",
        "reserved",
        "quality_status",
        "expiry_date",
        "available_on",
        "evidence"
      ],
      "title": "SupplierStock",
      "type": "object"
    },
    "SupplyRoute": {
      "additionalProperties": false,
      "properties": {
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "earliest_dispatch": {
          "format": "date",
          "title": "Earliest Dispatch",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "hospital_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Hospital Id",
          "type": "string"
        },
        "max_quantity": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Quantity",
          "type": "integer"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "protects_from_light": {
          "title": "Protects From Light",
          "type": "boolean"
        },
        "release_hold_authorized": {
          "default": false,
          "title": "Release Hold Authorized",
          "type": "boolean"
        },
        "route_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Route Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "temperature_max_c": {
          "title": "Temperature Max C",
          "type": "number"
        },
        "temperature_min_c": {
          "title": "Temperature Min C",
          "type": "number"
        },
        "transfer_permitted": {
          "default": false,
          "title": "Transfer Permitted",
          "type": "boolean"
        },
        "transit_days": {
          "maximum": 30,
          "minimum": 0,
          "title": "Transit Days",
          "type": "integer"
        }
      },
      "required": [
        "route_id",
        "source_id",
        "hospital_id",
        "product_id",
        "authorized",
        "max_quantity",
        "earliest_dispatch",
        "transit_days",
        "temperature_min_c",
        "temperature_max_c",
        "protects_from_light",
        "evidence"
      ],
      "title": "SupplyRoute",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Assumptions",
      "type": "array"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "base_dataset_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Dataset Version",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/MitigationCandidate"
      },
      "maxItems": 12,
      "title": "Candidates",
      "type": "array"
    },
    "catalog_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Catalog Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/SourceEvidence"
      },
      "maxItems": 60,
      "title": "Evidence",
      "type": "array"
    },
    "kind": {
      "const": "simulated",
      "default": "simulated",
      "title": "Kind",
      "type": "string"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/SupplyRoute"
      },
      "maxItems": 20,
      "title": "Routes",
      "type": "array"
    },
    "scenario_as_of": {
      "format": "date",
      "title": "Scenario As Of",
      "type": "string"
    },
    "supplier_stocks": {
      "items": {
        "$ref": "#/$defs/SupplierStock"
      },
      "maxItems": 20,
      "title": "Supplier Stocks",
      "type": "array"
    }
  },
  "required": [
    "catalog_id",
    "base_dataset_version",
    "scenario_as_of",
    "available_at",
    "supplier_stocks",
    "routes",
    "candidates",
    "evidence",
    "assumptions"
  ],
  "title": "MitigationCatalog",
  "type": "object"
}
