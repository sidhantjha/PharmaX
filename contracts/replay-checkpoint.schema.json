{
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "cutoff": {
      "format": "date-time",
      "title": "Cutoff",
      "type": "string"
    },
    "import_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Import Ids",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mode": {
      "enum": [
        "strict-historical",
        "reconstructed-historical-simulation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "parent_checkpoint_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Checkpoint Id"
    },
    "parent_cutoff": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Cutoff"
    },
    "parent_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Sha256"
    },
    "policy_version": {
      "const": "helene-admission-v1",
      "default": "helene-admission-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "scenario_id": {
      "const": "helene-north-cove",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "6a.1",
      "default": "6a.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Source Revision Ids",
      "type": "array"
    }
  },
  "required": [
    "checkpoint_id",
    "scenario_id",
    "cutoff",
    "mode",
    "source_revision_ids",
    "import_ids"
  ],
  "title": "ReplayCheckpoint",
  "type": "object"
}
