{
  "$defs": {
    "ArrivalOverride": {
      "additionalProperties": false,
      "properties": {
        "arrival_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival On"
        },
        "hold": {
          "default": false,
          "title": "Hold",
          "type": "boolean"
        },
        "shipment_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Shipment Id",
          "type": "string"
        }
      },
      "required": [
        "shipment_id"
      ],
      "title": "ArrivalOverride",
      "type": "object"
    },
    "CandidateEvaluation": {
      "additionalProperties": false,
      "properties": {
        "analysis_ids": {
          "items": {
            "type": "string"
          },
          "title": "Analysis Ids",
          "type": "array"
        },
        "candidate": {
          "$ref": "#/$defs/MitigationCandidate"
        },
        "evaluation_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/ConstraintFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/MitigationImpact"
          },
          "title": "Impacts",
          "type": "array"
        },
        "original_unmet": {
          "minimum": 0,
          "title": "Original Unmet",
          "type": "integer"
        },
        "projected_dataset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Dataset Version"
        },
        "projection_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Projection Evidence",
          "type": "array"
        },
        "quantity_moved": {
          "minimum": 0,
          "title": "Quantity Moved",
          "type": "integer"
        },
        "remaining_unmet": {
          "minimum": 0,
          "title": "Remaining Unmet",
          "type": "integer"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "supply_balance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupplyBalance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evaluation_id",
        "candidate",
        "feasible",
        "failures",
        "original_unmet",
        "remaining_unmet",
        "quantity_moved",
        "impacts",
        "evidence_ids",
        "analysis_ids"
      ],
      "title": "CandidateEvaluation",
      "type": "object"
    },
    "ConstraintFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNKNOWN_SOURCE",
            "UNKNOWN_ROUTE",
            "PRODUCT_MISMATCH",
            "PRESENTATION_MISMATCH",
            "INSUFFICIENT_UNRESERVED_STOCK",
            "QUARANTINED",
            "EXPIRED",
            "INSUFFICIENT_SHELF_LIFE",
            "SOURCE_NOT_AVAILABLE",
            "SOURCE_AUTHORIZATION",
            "TRANSFER_NOT_AUTHORIZED",
            "ROUTE_CAPACITY",
            "DELIVERY_TOO_LATE",
            "INVALID_DELIVERY_DATE",
            "TRANSPORT_REQUIREMENTS",
            "STORAGE_REQUIREMENTS",
            "HOLD_NOT_RELEASED",
            "DONOR_SHORTAGE",
            "DONOR_RISK_WORSE",
            "EVIDENCE_AFTER_CUTOFF",
            "SCENARIO_DATE_MISMATCH",
            "FUTURE_TRANSFER_UNSUPPORTED",
            "NO_IMPROVEMENT",
            "TARGET_MISMATCH",
            "EVIDENCE_LINEAGE"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail",
        "evidence_ids"
      ],
      "title": "ConstraintFailure",
      "type": "object"
    },
    "DailyConsumption": {
      "additionalProperties": false,
