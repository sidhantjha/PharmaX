    "ForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "arrival_shelf_life_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Arrival Shelf Life Days",
          "type": "integer"
        },
        "horizon_days": {
          "default": 14,
          "maximum": 60,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "hospital_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Hospital Id",
          "type": "string"
        },
        "overlay": {
          "anyOf": [
