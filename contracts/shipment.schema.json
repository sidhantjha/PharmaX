{
  "$defs": {
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dispatched_on": {
      "format": "date",
      "title": "Dispatched On",
      "type": "string"
    },
    "disruption_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Disruption Event Ids",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "expected_arrival": {
      "format": "date",
      "title": "Expected Arrival",
      "type": "string"
    },
    "hospital_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Hospital Id",
      "type": "string"
    },
    "origin_country_iso": {
      "pattern": "^[A-Z]{3}$",
      "title": "Origin Country Iso",
      "type": "string"
    },
    "product_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Product Id",
      "type": "string"
    },
    "protects_from_light": {
      "title": "Protects From Light",
      "type": "boolean"
    },
    "purchase_order_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Purchase Order Id",
      "type": "string"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "quantity_unit": {
      "const": "vial",
      "default": "vial",
      "title": "Quantity Unit",
      "type": "string"
    },
    "shipment_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Shipment Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "in_transit",
        "held"
      ],
      "title": "Status",
      "type": "string"
    },
    "supplier_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Supplier Id",
      "type": "string"
    },
    "temperature_max_c": {
      "title": "Temperature Max C",
      "type": "number"
    },
    "temperature_min_c": {
      "title": "Temperature Min C",
      "type": "number"
    }
  },
  "required": [
    "shipment_id",
    "purchase_order_id",
    "supplier_id",
    "hospital_id",
    "product_id",
    "quantity",
    "dispatched_on",
    "expected_arrival",
    "status",
    "origin_country_iso",
    "temperature_min_c",
    "temperature_max_c",
    "protects_from_light",
    "evidence"
  ],
  "title": "Shipment",
  "type": "object"
}
