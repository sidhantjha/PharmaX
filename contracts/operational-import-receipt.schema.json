{
  "$defs": {
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "derived",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "published_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "updated_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated On"
        },
        "version_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Available At"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "source_url",
        "observed_at",
        "content_sha256"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Future CSV/EDI/FHIR adapters must resolve into this simulated boundary.",
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "feed": {
      "enum": [
        "catalog",
        "inventory",
        "consumption",
        "purchasing",
        "purchase_orders",
        "acknowledgments",
        "shipments",
        "facilities",
        "suppliers"
      ],
      "title": "Feed",
      "type": "string"
    },
    "format": {
      "enum": [
        "csv",
        "edi-850",
        "edi-855",
        "edi-856",
        "fhir-r5-inventoryreport"
      ],
      "title": "Format",
      "type": "string"
    },
    "import_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Import Id",
      "type": "string"
    },
    "mapping_version": {
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "modeled_available_at": {
      "format": "date-time",
      "title": "Modeled Available At",
      "type": "string"
    },
    "record_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Record Ids",
      "type": "array"
    },
    "scenario_id": {
      "const": "helene-north-cove",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "6a.1",
      "default": "6a.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "validated",
        "quarantined"
      ],
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "import_id",
    "scenario_id",
    "feed",
    "format",
    "source_path",
    "content_sha256",
    "exported_at",
    "effective_at",
    "modeled_available_at",
    "evidence",
    "mapping_version",
    "record_ids",
    "validation_status",
    "assumptions"
  ],
  "title": "OperationalImportReceipt",
  "type": "object"
}
